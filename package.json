{
  "name": "primer-starter",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "zhixing": "node scripts/launcher.mjs",
    "desktop": "electron .",
    "pack:win": "node scripts/pack-win.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.74",
    "@ai-sdk/react": "^4.0.150",
    "@primer/octicons-react": "^19.28.1",
    "@primer/primitives": "^11.9.0",
    "@primer/react": "^38.27.0",
    "ai": "^7.0.146",
    "cross-spawn": "^7.0.6",
    "d3-force": "^3.0.0",
    "fflate": "^0.8.3",
    "mind-elixir": "5.15.1",
    "modern-screenshot": "^4.7.0",
    "next": "^15.5.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "styled-components": "^6.4.2",
    "swr": "^2.5.1",
    "undici": "^7.30.1",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.6.0",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["electron", "electron-winstaller", "sharp"]
  },
  "build": {
    "appId": "app.zhixing.desktop",
    "productName": "知行",
    "executableName": "Zhixing",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json",
      "build/icon.png",
      "!node_modules/**"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs",
      "dependencies": {}
    },
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/standalone/node_modules",
        "to": "standalone/node_modules"
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/public"
      },
      {
        "from": "content",
        "to": "standalone/content"
      },
      {
        "from": "build/icon.png",
        "to": "build/icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "知行",
      "artifactName": "Zhixing-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Zhixing-Portable-${version}.${ext}"
    }
  }
}
